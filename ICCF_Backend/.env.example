# ==============================================================================
# MRU SkillCert - Backend Server Environment Variables
# ==============================================================================

# Application Port and Environment
PORT=5000
NODE_ENV=production

# Supabase Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-private
DATABASE_URL=postgresql://postgres:your-db-password@your-db-host:5432/postgres

# JWT Access Token Configuration (Strict 30-Second Lifetime)
JWT_SECRET=your-cryptographically-secure-server-signing-secret-min-64-characters
JWT_ACCESS_EXPIRES_IN=30s
JWT_REFRESH_EXPIRES_DAYS=7
JWT_ISSUER=mru-skillcert
JWT_AUDIENCE=mru-api

# Secure Cookie Configuration (HttpOnly, Secure in production)
COOKIE_SECRET=your-cryptographically-secure-cookie-secret-min-64-characters

# CORS Approved Frontend Origins (comma separated)
CORS_ORIGIN=https://skillcert.mru.edu.in,http://localhost:3000

# Central University Administration Bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin.iccf@mru.edu.in

# Cloud Email Service for Student 2FA OTP & Password Recovery (Resend / Brevo)
EMAIL_SERVICE_API_KEY=your-email-service-api-key
EMAIL_FROM_ADDRESS=SkillCert Authenticator <no-reply@mru.edu.in>
